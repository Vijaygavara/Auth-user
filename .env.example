# -----------------------------------------------------------------------------
# secure-auth-api environment template
#
# Copy to .env for local development:   cp .env.example .env
# This file IS committed. It documents every variable but must never contain
# real secrets. The real .env is git-ignored.
# -----------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=5000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/secure_auth_db"

# Redis connection. Formats:
#   redis://localhost:6379                       local, no password (Memurai/Redis default)
#   redis://:PASSWORD@host:6379                  password (requirepass)
#   redis://USERNAME:PASSWORD@host:6379          Redis 6+ ACL user
#   rediss://...                                 TLS (managed Redis: ElastiCache, Upstash, Redis Cloud)
REDIS_URL="redis://localhost:6379"

# JWT signing secret: at least 32 characters. The app refuses to start in
# production with this placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace_with_a_long_random_secret"
# Token lifetime: seconds or a duration string (15m, 1h, 1d)
JWT_EXPIRES_IN="1d"

# Allowed browser origin(s), comma-separated full URLs
CORS_ORIGIN="http://localhost:3000"

# bcrypt cost factor (10-15). Each +1 doubles hashing time.
BCRYPT_SALT_ROUNDS=12

# Optional: fatal | error | warn | info | debug | trace | silent
# Defaults: debug (development), info (production), silent (test)
# LOG_LEVEL=info

# How Express derives the client IP (req.ip) from X-Forwarded-For.
# Getting this wrong breaks per-IP rate limiting.
#   false                    -> no proxy: localhost, or the app is exposed directly
#   1                        -> exactly one proxy in front (Nginx, Render, Railway, Heroku, AWS ALB)
#   2                        -> two proxies (e.g. Cloudflare -> Nginx -> app)
#   loopback,172.16.0.0/12   -> trust only these proxy addresses/subnets (Docker networks)
# "true" trusts any forwarded header and is rejected in production.
TRUST_PROXY=false

# Login rate limiting: max attempts per client IP per window
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
